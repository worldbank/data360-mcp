DATA360_API_BASE_URL=https://data360api.worldbank.org
# Outbound HTTP resilience for every Data360 API call (see src/data360/http_client.py).
# Defaults shown; raise DATA360_READ_TIMEOUT only if the API is legitimately slow.
# DATA360_CONNECT_TIMEOUT=3
# DATA360_READ_TIMEOUT=8
# DATA360_WRITE_TIMEOUT=8
# DATA360_POOL_TIMEOUT=3
# DATA360_RETRY_MAX_ATTEMPTS=3
# DATA360_RETRY_BUDGET_SECONDS=16    # set <= DATA360_READ_TIMEOUT to never retry a timeout
# DATA360_RETRY_BACKOFF_BASE=0.3
# DATA360_RETRY_BACKOFF_MAX=2
# DATA360_RETRY_STATUS_CODES=[429,502,503,504]
# How long a stale metadata snapshot / upstream error is reused before retrying the API.
# DATA360_DEGRADATION_COOLDOWN_SECONDS=30
# Background/bulk calls (dimension catalog ~1.7 MB, dataset catalogue, group hierarchy):
# separate client + connection pool, so a slow bulk fetch cannot starve user requests.
# DATA360_BACKGROUND_CONNECT_TIMEOUT=5
# DATA360_BACKGROUND_READ_TIMEOUT=30
# DATA360_BACKGROUND_WRITE_TIMEOUT=30
# DATA360_BACKGROUND_POOL_TIMEOUT=5
# DATA360_BACKGROUND_RETRY_MAX_ATTEMPTS=3
# DATA360_BACKGROUND_RETRY_BUDGET_SECONDS=60
# How long a user request may wait for the catalog before serving raw codes (0 = never).
# DATA360_BACKGROUND_INLINE_WAIT_SECONDS=2
# Optional base URL for static viz JSON URLs (defaults to http://localhost:MCP_PORT). Use a
# browser-reachable origin, e.g. http://127.0.0.1:8000 — see visualization.save_specs_to_static.
# WEBSITE_HOSTNAME=http://127.0.0.1:8000
MCP_PORT=8000  # use 8022 in dev
MCP_TRANSPORT=http

# FastMCP 3.4.3+ Host/Origin guard. The server defaults these to ["*"] so any Host works
# (FastMCP 2.x behaviour) — without that, a proxied/containerised deploy gets 421 on /mcp.
# Narrow them per environment if you want the DNS-rebinding check to bind. JSON lists.
# FASTMCP_HTTP_ALLOWED_HOSTS=["data360-mcp.worldbank.org","*.worldbank.org"]
# FASTMCP_HTTP_ALLOWED_ORIGINS=["https://claude.ai"]
MCP_CHARTS_API_URL=https://localhost:8001/api/v1/charts
MCP_CHARTS_API_TOKEN=replace-with-charts-write-token

# Health / readiness (GET /health liveness, GET /ready dependency probes)
# MCP_READINESS_ENABLED=true
# MCP_HEALTH_CHECK_TIMEOUT=5

# Optional: set to 'local' to enable local telemetry (OTLP or console).
# MCP_ENV=local
# Run docker container: docker run --rm -d --name jaeger -p 16686:16686 -p 4317:4317 -p 4318:4318 jaegertracing/jaeger:latest
# Then set the following environment variables:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_SERVICE_NAME=data360-mcp
